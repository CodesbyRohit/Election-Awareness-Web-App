<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mock Voting</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-light bg-light">
    <div class="container">
      <a class="navbar-brand" href="/">Election Awareness</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav">
          <li class="nav-item">
            <a class="nav-link" href="/">Home</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/eligibility">Eligibility</a>
          </li>
          <li class="nav-item">
            <a class="nav-link active" href="/vote">Vote</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/info">Info</a>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <div class="container mt-5">
    <h1 class="text-center mb-4">Mock Voting</h1>
    <% if (voted) { %>
    <div class="alert alert-success text-center">
      Thank you for voting! You selected Candidate <%= selected %>.
    </div>
    <% } else { %>
    <p class="text-center">Select a candidate to vote for:</p>
    <form action="/vote" method="post" class="w-50 mx-auto">
      <% candidates.forEach(c => { %>
      <div class="form-check">
        <input class="form-check-input" type="radio" name="candidate" id="<%= c %>" value="<%= c %>" required>
        <label class="form-check-label" for="<%= c %>">
          Candidate <%= c %>
        </label>
      </div>
      <% }) %>
      <button type="submit" class="btn btn-success mt-3">Vote</button>
    </form>
    <% } %>

    <h2 class="text-center mt-5">Current Vote Counts</h2>
    <ul class="list-group w-50 mx-auto">
      <% candidates.forEach(c => { %>
      <li class="list-group-item d-flex justify-content-between align-items-center <%= selected === c ? 'list-group-item-success' : '' %>">
        Candidate <%= c %>
        <span class="badge bg-primary rounded-pill"><%= votes[c] %></span>
      </li>
      <% }) %>
    </ul>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>