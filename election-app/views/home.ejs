<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Election Awareness Web App</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-light bg-light">
    <div class="container">
      <a class="navbar-brand" href="/">Election Awareness</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav">
          <li class="nav-item">
            <a class="nav-link" href="/">Home</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/eligibility">Eligibility</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/vote">Vote</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/info">Info</a>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <div class="container mt-5">
    <h1 class="text-center mb-4">Election Awareness Web App</h1>
    <p class="text-center lead">Learn about elections in India, check your voting eligibility, and participate in a mock voting experience.</p>

    <h2 class="mt-5">Why Voting Matters</h2>
    <div class="row">
      <div class="col-md-4">
        <div class="card mb-4">
          <div class="card-body">
            <h5 class="card-title">Shape Your Future</h5>
            <p class="card-text">Your vote influences government policies that affect education, healthcare, and infrastructure.</p>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card mb-4">
          <h5 class="card-title">Community Impact</h5>
          <p class="card-text">Voting helps build stronger communities by electing representatives who understand local needs.</p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card mb-4">
          <h5 class="card-title">Democratic Duty</h5>
          <p class="card-text">Participating in elections is a fundamental right and responsibility in a democracy.</p>
        </div>
      </div>
    </div>

    <div class="text-center mt-5">
      <a href="/eligibility" class="btn btn-primary btn-lg me-3">Check Eligibility</a>
      <a href="/vote" class="btn btn-success btn-lg me-3">Mock Voting</a>
      <a href="/info" class="btn btn-info btn-lg">Learn More</a>
    </div>
  </div>

  <footer class="bg-light text-center text-muted mt-5 py-3">
    <p>&copy; 2026 Election Awareness Web App. Built for Hack-2-Skill Competition.</p>
  </footer>

